# Google AI Platform (Required)
GOOGLE_API_KEY="your-google-api-key"
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_REGION="us-central1"

# Application Config
DEBUG=True
HOST="0.0.0.0"
PORT=8000
HOSPITAL_NAME="City Care Hospital"
HOSPITAL_PHONE="+1-800-ABC-HOSP"
RECEPTIONIST_PHONE="+1-800-ABC-RECV"

# Exotel (Optional: for live inbound phone calls)
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_PHONE_NUMBER=""

# Phone Transfer Destinations
DOCTOR_PHONE_NUMBER=""
EMERGENCY_PHONE_NUMBER=""

# Vapi (Optional: for Vapi call integration)
VAPI_API_KEY=""

# Database (handled automatically in Docker Compose)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/hospital_ai"
DATABASE_URL_SYNC="postgresql://postgres:password@localhost:5432/hospital_ai"

# Security
SECRET_KEY="generate-a-random-64-char-string-here"
